{
    "name": "@ostro/cookie",
    "version": "2.0.0-alpha.4",
    "description": "Cookie module for OstroJS",
    "main": "jar.js",
    "scripts": {
        "test": "jest",
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.3",
        "@ostro/support": "^2.0.0-alpha.3",
        "cookie": "^0.7.2",
        "cookie-signature": "^1.2.2",
        "lodash.get": "^4.4.2",
        "lodash.set": "^4.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "cookie"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/cookie.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/cookie/issues"
    },
    "homepage": "https://github.com/ostrojs/cookie#readme",
    "types": ".typed/jar.d.ts",
    "exports": {
        ".": {
            "types": "./.typed/jar.d.ts",
            "default": "./jar.js"
        },
        "./*": {
            "types": "./.typed/*.d.ts",
            "default": "./*.js"
        }
    },
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
